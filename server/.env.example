# ---- Server ----
PORT=5001
# Path to SQLite database file (optional)
# DB_PATH=

# ---- Sessions / auth ----
# Days a login session stays valid before expiring (default 30)
SESSION_TTL_DAYS=30
# Set to true when serving over HTTPS so Session cookie gets the Secure flag
COOKIE_SECURE=false
# Seed the first admin via npm run create-admin (email/name/password)
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=

# ---- WhatsApp Business API (Meta) ----
# Create an app at https://developers.facebook.com, get a test number from
# https://business.whatsapp.com/developers/cloud-api/guide
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Your business WhatsApp number (only used for the test message recipient default)
WHATSAPP_FROM_PHONE=
# Template language (default en_US). Use the language code of your approved template.
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Country code used to normalize local 10-digit numbers (default 91 = India)
WHATSAPP_COUNTRY_CODE=91
# Set to true to log reminders instead of actually sending (safe for testing)
WHATSAPP_DRY_RUN=true
# Reminder template (default fee_reminder) — 4 body vars + 1 "Pay Now" URL button
WHATSAPP_TEMPLATE_NAME=fee_reminder
# Receipt template (default payment_receipt) — 3 body vars: name, amount, date
# + a "View Receipt" URL button pointing at <SHARE_BASE>/share/r/{{1}}.
# Sent automatically to the parent whenever a payment is confirmed (Razorpay
# webhook or manual Cash/UPI collect).
# WHATSAPP_RECEIPT_TEMPLATE_NAME=payment_receipt
# Public base URL for parent-facing receipt pages (domain must be verified with
# Meta for the URL button). Defaults to http://localhost:5001 outside production.
# WHATSAPP_RECEIPT_SHARE_BASE=https://crm.example.com
# Optional webhook verify token if you later integrate message replies
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- Course-completion certificate ----
# Brand / owner names printed on generated certificates
# CERT_BRAND=Pravaha Art Space
# CERT_OWNER=Radha Kannan
# CERT_OWNER_TITLE=Founder — Right & Left Learning Academy
# Path to the real signature image (PNG with transparent bg). If unset/missing,
# the owner name is drawn in a script font as a placeholder.
# CERT_SIGNATURE_PATH=

# ---- Razorpay (payment links in reminders) ----
# Get test keys instantly from https://dashboard.razorpay.com/app/keys (Test mode).
# Live keys are enabled after account/KYC verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay webhook you create (Settings > Webhooks). Verifies incoming callbacks.
RAZORPAY_WEBHOOK_SECRET=
# How long the payment link stays valid (default 7 days)
# RAZORPAY_LINK_EXPIRY_DAYS=7